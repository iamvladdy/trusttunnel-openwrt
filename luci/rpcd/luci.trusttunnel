// TrustTunnel rpcd backend
// Reads process state, interface counters and log to provide status data to LuCI
'use strict';

import { popen, readfile } from 'fs';
import { cursor } from 'uci';

const RUN_DIR = '/var/run/trusttunnel';
const CLIENT_BIN = '/opt/trusttunnel_client/trusttunnel_client';

function trim_str(s) {
	return s ? replace(s, /^\s+|\s+$/g, '') : '';
}

function read_file(path) {
	return trim_str(readfile(path) ?? '');
}

function read_num(path) {
	const v = readfile(path);
	return v ? int(trim_str(v)) : 0;
}

// Run a command and return its trimmed stdout. Closes the handle, unlike a
// bare popen() chain, so repeated polling does not leak descriptors.
function sh(cmd) {
	const h = popen(cmd);
	if (!h)
		return '';
	const out = h.read('all') ?? '';
	h.close();
	return trim_str(out);
}

function has_cmd(name) {
	return length(sh(`command -v ${name} 2>/dev/null`)) > 0;
}

// BusyBox has carried two incompatible timeout syntaxes ("timeout SECS CMD"
// and the older "timeout -t SECS CMD"). Probe once rather than assume, so a
// mismatch cannot turn into a command that never runs.
function timeout_prefix(secs) {
	if (sh(`timeout 1 true >/dev/null 2>&1 && echo ok`) == 'ok')
		return `timeout ${secs} `;
	if (sh(`timeout -t 1 true >/dev/null 2>&1 && echo ok`) == 'ok')
		return `timeout -t ${secs} `;
	return '';
}

// Last non-empty line — where command line tools put the actual failure.
function last_line(text) {
	const lines = split(text ?? '', '\n');
	for (let i = length(lines) - 1; i >= 0; i--) {
		const l = trim_str(lines[i]);
		if (length(l))
			return (length(l) > 200) ? substr(l, 0, 200) : l;
	}
	return '';
}

function is_running(pid) {
	if (!pid || pid == '')
		return false;
	// Check /proc/<pid>/status — exists only for live processes
	const status = readfile(`/proc/${pid}/status`);
	return (status != null);
}

// Seconds the client process has been alive, derived from its starttime in
// /proc/<pid>/stat (field 22, in clock ticks) against /proc/uptime.
function proc_uptime(pid) {
	const stat = readfile(`/proc/${pid}/stat`);
	if (!stat)
		return 0;

	// The comm field may contain spaces, so start parsing after the last ')'
	const close = rindex(stat, ')');
	if (close < 0)
		return 0;

	const fields = split(trim_str(substr(stat, close + 1)), ' ');
	// After ')' the first field is state (field 3), so starttime is index 19
	const starttime = int(fields[19] ?? 0);
	if (!starttime)
		return 0;

	const up = split(read_file('/proc/uptime'), ' ');
	const total = int(up[0] ?? 0);
	const secs = total - (starttime / 100);   // USER_HZ is 100 on Linux
	return (secs > 0) ? int(secs) : 0;
}

// Read a `key = value` line from the TOML config.
//
// Done with plain string ops rather than a regex: ucode has no multiline flag
// and no dynamic regex construction, so a per-line prefix match is both
// simpler and safer. A commented line never matches, because the '#' stays in
// front of the key.
function conf_value(text, key) {
	if (!text)
		return '';

	const lines = split(text, '\n');
	for (let i = 0; i < length(lines); i++) {
		const line = trim_str(lines[i]);
		if (substr(line, 0, length(key)) != key)
			continue;
		// Guard against a longer key with the same prefix (mtu_size vs mtu)
		const rest = trim_str(substr(line, length(key)));
		if (substr(rest, 0, 1) != '=')
			continue;
		return trim_str(substr(rest, 1));
	}
	return '';
}

function unquote(s) {
	return trim_str(replace(s ?? '', /^["']|["']$/g, ''));
}

// Collect every quoted string out of one match result, tolerating both shapes
// a g-flag match can return (array of groups, or bare strings).
function collect_quoted(line, out) {
	const items = match(line, /"([^"]+)"/g);
	for (let i = 0; i < length(items ?? []); i++) {
		const it = items[i];
		const v = (type(it) == 'array') ? it[1] : it;
		if (v)
			push(out, replace(v, /"/g, ''));
	}
}

// addresses may be written inline or spread over several lines:
//   addresses = ["1.2.3.4:443"]
//   addresses = [
//     "1.2.3.4:443",
//   ]
// so keep reading until the closing bracket instead of looking at one line.
function parse_addresses(text) {
	const lines = split(text ?? '', '\n');
	const out = [];
	let collecting = false;

	for (let i = 0; i < length(lines); i++) {
		let line = trim_str(lines[i]);

		if (!collecting) {
			if (substr(line, 0, 9) != 'addresses')
				continue;
			const rest = trim_str(substr(line, 9));
			if (substr(rest, 0, 1) != '=')
				continue;
			line = trim_str(substr(rest, 1));
			collecting = true;
		}

		collect_quoted(line, out);

		if (index(line, ']') >= 0)
			break;
	}

	return out;
}

function parse_config(path) {
	const text = readfile(path) ?? '';
	const addrs = parse_addresses(text);

	// A pinned certificate is usually a TOML multi-line string, so the value on
	// the key line is just `"""` — test for "not empty" the same way the proto
	// handler does rather than trying to unquote it.
	const cert_raw = conf_value(text, 'certificate');
	const has_cert = !(cert_raw == '' || cert_raw == '""' ||
	                   cert_raw == "''" || cert_raw == 'null');

	return {
		hostname:      unquote(conf_value(text, 'hostname')),
		// When set, this replaces hostname as the TLS SNI, so the certificate
		// check must use it too or it would query the wrong virtual host.
		custom_sni:    unquote(conf_value(text, 'custom_sni')),
		addresses:     addrs,
		mtu_size:      unquote(conf_value(text, 'mtu_size')),
		skip_verify:   unquote(conf_value(text, 'skip_verification')) == 'true',
		has_cert:      has_cert,
		killswitch:    unquote(conf_value(text, 'killswitch_enabled')) == 'true',
		vpn_mode:      unquote(conf_value(text, 'vpn_mode')),
		upstream:      unquote(conf_value(text, 'upstream_protocol')),
	};
}

function parse_log_status(log) {
	if (!log || log == '')
		return 'unknown';

	// Search log in order — last matching line wins
	const lines = split(log, '\n');
	let state = 'unknown';

	for (let i = 0; i < length(lines); i++) {
		const line = lines[i];
		if (index(line, 'VPN_SS_CONNECTED') >= 0)
			state = 'connected';
		else if (index(line, 'VPN_SS_CONNECTING') >= 0)
			state = 'connecting';
		else if (index(line, 'VPN_SS_DISCONNECTED') >= 0)
			state = 'disconnected';
		else if (index(line, 'Failed to create listener') >= 0)
			state = 'error';
		else if (index(line, 'Number of connection attempts exceeded') >= 0)
			state = 'error';
		else if (index(line, 'Unable to setup routes') >= 0)
			state = 'error';
		// TLS / certificate verification failures. BoringSSL reports a
		// missing or unusable trust store with an empty error queue, which
		// prints as "invalid library (0):OPENSSL_internal:unknown library".
		else if (index(line, 'OPENSSL_internal') >= 0)
			state = 'error';
		else if (index(line, 'invalid library') >= 0)
			state = 'error';
		else if (index(line, 'certificate verify failed') >= 0)
			state = 'error';
		else if (index(line, 'Handshake failed') >= 0)
			state = 'error';
		else if (index(line, 'Authorization failed') >= 0)
			state = 'error';
	}

	return state;
}

// Take the first line of a captured value. Used instead of putting '\n' in a
// negated character class: an escape inside a bracket expression is not
// portable, and '[^,\n]' can degrade into "not comma, not backslash, not n",
// which truncates any hostname containing the letter n.
function first_line(s) {
	return trim_str(split(s ?? '', '\n')[0] ?? '');
}

function parse_endpoint(log) {
	if (!log) return '';
	// Line example: Using endpoint: name=tt.example.com, address=1.2.3.4:443, ...
	const m = match(log, /Using endpoint: name=([^,]+)/);
	return m ? first_line(m[1]) : '';
}

function parse_endpoint_ip(log) {
	if (!log) return '';
	// The address may be a hostname:port, not just IP:port, so match up to the
	// next separator rather than hex/dot/colon only.
	const m = match(log, /address=([^,]+)/);
	return m ? first_line(m[1]) : '';
}

function parse_last_error(log) {
	if (!log) return '';
	const lines = split(log, '\n');
	for (let i = length(lines) - 1; i >= 0; i--) {
		if (index(lines[i], 'ERROR') >= 0)
			return trim_str(replace(lines[i], /^[^ ]+ [^ ]+ ERROR +\[[0-9]+\] /, ''));
	}
	return '';
}

// Interface names configured with proto=trusttunnel. Used both to build the
// status list and to validate names before they reach a shell command.
function tt_interfaces() {
	const uci = cursor();
	uci.load('network');

	const list = [];
	uci.foreach('network', 'interface', function(s) {
		if (s.proto == 'trusttunnel')
			push(list, s['.name']);
	});
	return list;
}

function tt_config_file(iface) {
	const uci = cursor();
	uci.load('network');
	return uci.get('network', iface, 'config_file')
		?? '/opt/trusttunnel_client/trusttunnel_client.toml';
}

function is_valid_iface(iface) {
	const list = tt_interfaces();
	for (let i = 0; i < length(list); i++)
		if (list[i] == iface)
			return true;
	return false;
}

// Only hostnames/IPs and ports may be interpolated into a shell command.
//
// The character class deliberately contains no escaped characters: an escape
// inside a bracket expression is not portable across regex engines, and
// '[A-Za-z0-9._:\[\]-]' silently degrades into a pattern that matches nothing
// useful. Bracketed IPv6 literals never reach here — split_host_port() strips
// the brackets first.
function safe_host(s) {
	return match(s ?? '', /^[0-9A-Za-z._:-]+$/) ? s : '';
}

function split_host_port(addr, fallback_host) {
	let host = fallback_host;
	let port = '443';

	if (addr) {
		// [v6]:port | host:port | host
		const m6 = match(addr, /^\[([0-9a-fA-F:]+)\]:?([0-9]*)$/);
		if (m6) {
			host = m6[1];
			if (m6[2]) port = m6[2];
		}
		else {
			const m = match(addr, /^([A-Za-z0-9._-]+):([0-9]+)$/);
			if (m) {
				host = m[1];
				port = m[2];
			}
			else if (match(addr, /^[A-Za-z0-9._-]+$/))
				host = addr;
		}
	}

	return { host: host, port: port };
}

// Work out what to probe for an interface, trying every source rather than
// trusting the config parse alone: a config the reader cannot handle would
// otherwise disable the certificate and latency checks entirely. The client
// log is authoritative — it records the endpoint the client actually used.
function endpoint_target(iface) {
	const conf = parse_config(tt_config_file(iface));
	const log = read_file(`${RUN_DIR}/${iface}.log`);
	const log_name = parse_endpoint(log);
	const log_addr = parse_endpoint_ip(log);

	const cands = [];
	if (length(conf.addresses))
		push(cands, conf.addresses[0]);
	if (conf.hostname)
		push(cands, conf.hostname);
	if (log_addr)
		push(cands, log_addr);
	if (log_name)
		push(cands, log_name);

	// SNI must be a name, never an IP literal. custom_sni wins when present,
	// because that is what the client itself sends.
	const sni = safe_host(conf.custom_sni) || safe_host(conf.hostname) ||
		safe_host(log_name) || '';

	for (let i = 0; i < length(cands); i++) {
		const hp = split_host_port(cands[i], '');
		const host = safe_host(hp.host);
		if (!host)
			continue;
		return {
			host: host,
			port: match(hp.port, /^[0-9]+$/) ? hp.port : '443',
			sni:  sni || host,
			from: (i == 0 && length(conf.addresses)) ? 'config' : 'log',
		};
	}

	return null;
}

function parse_ping(out) {
	if (!out)
		return null;

	// BusyBox: "round-trip min/avg/max = 6.5/8.5/10.5 ms"
	// iputils:  "rtt min/avg/max/mdev = 6.5/8.5/10.5/1.2 ms"
	const r = match(out, /= *([0-9.]+)\/([0-9.]+)\/([0-9.]+)/);
	const loss = match(out, /([0-9]+)% packet loss/);

	// On failure report what ping actually said. "Network is unreachable" and
	// "100% packet loss" mean very different things, and collapsing both into
	// "no reply" throws away the only useful part of the result.
	let reason = '';
	if (!r) {
		// Plain substring search over lines rather than a regex — keeps the
		// pattern free of bracket-class escapes entirely.
		const needles = [ 'nreachable', 'not permitted', 'bad address',
		                  'unknown host', 'Operation not' ];
		const lines = split(out, '\n');

		for (let i = 0; i < length(lines) && !reason; i++)
			for (let j = 0; j < length(needles); j++)
				if (index(lines[i], needles[j]) >= 0) {
					reason = trim_str(lines[i]);
					break;
				}

		if (!reason && loss)
			reason = `${loss[1]}% packet loss`;
		if (!reason)
			reason = first_line(out);
	}

	return {
		min:    r ? r[1] : '',
		max:    r ? r[3] : '',
		avg:    r ? r[2] : '',
		loss:   loss ? int(loss[1]) : 100,
		ok:     (r != null),
		reason: reason,
	};
}

const methods = {
	getTrustTunnelStatus: {
		call: function() {
			const result = {};
			const ifaces = tt_interfaces();

			for (let i = 0; i < length(ifaces); i++) {
				const iface = ifaces[i];
				const pid = read_file(`${RUN_DIR}/${iface}.pid`);
				const running = is_running(pid);
				const log = read_file(`${RUN_DIR}/${iface}.log`);
				const state = running ? parse_log_status(log) : 'stopped';

				const config_file = tt_config_file(iface);
				const conf = parse_config(config_file);

				// Addresses from the config are shown even while the tunnel is
				// down, unlike the log-derived endpoint.
				const sys = `/sys/class/net/${iface}`;

				const ip_out = sh(`ip -4 addr show dev ${iface} 2>/dev/null`);
				const ip_m = match(ip_out, /inet ([0-9.]+\/[0-9]+)/);

				const ip6_out = sh(`ip -6 addr show dev ${iface} scope global 2>/dev/null`);
				const ip6_m = match(ip6_out, /inet6 ([0-9a-f:]+\/[0-9]+)/);

				result[iface] = {
					name:         iface,
					pid:          running ? pid : '',
					running:      running,
					state:        state,
					uptime:       running ? proc_uptime(pid) : 0,

					tun_ip:       ip_m  ? ip_m[1]  : '',
					tun_ip6:      ip6_m ? ip6_m[1] : '',
					mtu:          read_num(`${sys}/mtu`),
					oper_state:   read_file(`${sys}/operstate`),

					rx_bytes:     read_num(`${sys}/statistics/rx_bytes`),
					tx_bytes:     read_num(`${sys}/statistics/tx_bytes`),
					rx_packets:   read_num(`${sys}/statistics/rx_packets`),
					tx_packets:   read_num(`${sys}/statistics/tx_packets`),
					rx_errors:    read_num(`${sys}/statistics/rx_errors`),
					tx_errors:    read_num(`${sys}/statistics/tx_errors`),

					endpoint:     parse_endpoint(log) || conf.hostname,
					endpoint_ip:  parse_endpoint_ip(log),
					addresses:    conf.addresses,
					hostname:     conf.hostname,
					custom_sni:   conf.custom_sni,

					// Config facts worth surfacing — each has bitten someone
					skip_verify:  conf.skip_verify,
					has_cert:     conf.has_cert,
					killswitch:   conf.killswitch,
					vpn_mode:     conf.vpn_mode,
					upstream:     conf.upstream,

					// Show the last error whenever the tunnel is not healthy —
					// a running-but-failing client is the common case.
					last_error:   (state == 'connected') ? '' : parse_last_error(log),
					config_file:  config_file,
				};
			}

			return result;
		}
	},

	// Endpoint certificate expiry — the failure mode that is invisible until
	// the tunnel dies. On demand only: it opens a TLS connection.
	getCertInfo: {
		args: { iface: 'iface' },
		call: function(req) {
			const iface = req.args?.iface ?? '';
			if (!is_valid_iface(iface))
				return { error: 'unknown interface' };

			if (!has_cmd('openssl'))
				return { error: 'openssl-util is not installed' };

			const tgt = endpoint_target(iface);
			if (!tgt)
				return { error: 'no usable endpoint address found in the ' +
					'client config or log — check [endpoint] hostname/addresses' };

			const host = tgt.host, port = tgt.port, sni = tgt.sni;

			// Keep stdout and stderr in separate files instead of piping into a
			// second openssl: the PEM stays clean, and stderr keeps the reason
			// the handshake failed rather than it being discarded.
			const pem_file = `/tmp/tt-cert-${iface}.pem`;
			const err_file = `/tmp/tt-cert-${iface}.err`;

			sh(`echo | ${timeout_prefix(10)}openssl s_client ` +
				`-connect ${host}:${port} -servername ${sni} ` +
				`>${pem_file} 2>${err_file}`);

			const pem = readfile(pem_file) ?? '';
			const errout = readfile(err_file) ?? '';

			if (index(pem, 'BEGIN CERTIFICATE') < 0) {
				sh(`rm -f ${pem_file} ${err_file}`);
				const why = last_line(errout);
				return { error: why
					? `no certificate from ${host}:${port} — ${why}`
					: `no TLS response from ${host}:${port}` };
			}

			// s_client writes a chain listing and session details around the
			// PEM, so cut out just the first certificate block instead of
			// relying on the parser to skip the preamble.
			const crt_file = `${pem_file}.crt`;
			sh(`sed -n '/BEGIN CERTIFICATE/,/END CERTIFICATE/p' ${pem_file} ` +
				`| sed '/END CERTIFICATE/q' > ${crt_file}`);

			const out = sh(`openssl x509 -in ${crt_file} ` +
				`-noout -subject -issuer -enddate 2>&1`);
			sh(`rm -f ${pem_file} ${err_file} ${crt_file}`);

			const not_after = match(out, /notAfter=(.+)/);
			const subject   = match(out, /subject=(.+)/);
			const issuer    = match(out, /issuer=(.+)/);

			if (!not_after)
				return { error: `could not read the certificate — ${last_line(out)}` };

			return {
				host:      `${host}:${port}`,
				sni:       sni,
				// Raw OpenSSL date string; the day count is computed in the
				// browser, which has real date parsing.
				not_after: not_after ? trim_str(not_after[1]) : '',
				subject:   subject   ? trim_str(subject[1])   : '',
				issuer:    issuer    ? trim_str(issuer[1])    : '',
			};
		}
	},

	// Latency to the endpoint and through the tunnel. On demand: takes seconds.
	getLatency: {
		args: { iface: 'iface' },
		call: function(req) {
			const iface = req.args?.iface ?? '';
			if (!is_valid_iface(iface))
				return { error: 'unknown interface' };

			const tgt = endpoint_target(iface);
			const res = {};

			// Kept short: both pings run inside a single ubus call, so the
			// worst case must stay well under the request timeout.
			if (tgt)
				res.endpoint = parse_ping(sh(`ping -c 2 -W 1 -q ${tgt.host} 2>&1`));

			// Through the tunnel — only meaningful while the device exists.
			//
			// ICMP is tried first but usually fails: the tunnel forwards TCP
			// fine (curl --interface works) while echo requests are not
			// carried. So fall back to timing a TCP handshake, which is a real
			// round trip through the tunnel and needs no DNS or third party
			// service beyond a well-known address.
			if (readfile(`/sys/class/net/${iface}/mtu`) != null) {
				const icmp = parse_ping(
					sh(`ping -c 2 -W 1 -q -I ${iface} 1.1.1.1 2>&1`));

				if (icmp && icmp.ok) {
					icmp.method = 'icmp';
					res.tunnel = icmp;
				}
				else {
					const t = sh(`curl -s -o /dev/null -w '%{time_connect}' ` +
						`--interface ${iface} --max-time 8 http://1.1.1.1/ 2>/dev/null`);
					const m = match(trim_str(t), /^([0-9]+\.[0-9]+)$/);

					if (m && m[1] + 0 > 0)
						res.tunnel = {
							ok: true,
							method: 'tcp',
							// Seconds as printed by curl; converted to ms in
							// the browser, like the certificate date.
							connect_s: m[1],
						};
					else
						res.tunnel = {
							ok: false,
							method: 'tcp',
							reason: icmp && icmp.reason
								? `ICMP: ${icmp.reason}; TCP connect also failed`
								: 'neither ICMP nor a TCP connect got through',
						};
				}
			}

			return res;
		}
	},

	setInterfaceState: {
		args: { iface: 'iface', action: 'action' },
		call: function(req) {
			const iface = req.args?.iface ?? '';
			const action = req.args?.action ?? '';

			// Never interpolate a name that is not a configured tt interface
			if (!is_valid_iface(iface))
				return { success: false, error: 'unknown interface' };

			if (action == 'up')
				sh(`ifup ${iface} 2>&1`);
			else if (action == 'down')
				sh(`ifdown ${iface} 2>&1`);
			else if (action == 'restart')
				sh(`ifdown ${iface} 2>&1; sleep 1; ifup ${iface} 2>&1`);
			else
				return { success: false, error: 'invalid action' };

			return { success: true };
		}
	},

	getClientLog: {
		args: { iface: 'iface', lines: 0 },
		call: function(req) {
			const iface = req.args?.iface ?? '';
			if (!is_valid_iface(iface))
				return { error: 'unknown interface' };

			const n = int(req.args?.lines ?? 50);
			const count = (n > 0 && n <= 500) ? n : 50;

			return {
				log: sh(`tail -n ${count} ${RUN_DIR}/${iface}.log 2>/dev/null`),
				version: sh(`${CLIENT_BIN} --version 2>/dev/null | head -1`),
			};
		}
	}
};

return { 'luci.trusttunnel': methods };
